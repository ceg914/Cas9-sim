; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PaleoSphere"
config/description="선사 생태계 시뮬레이터"
config/version="0.1.0"
run/main_scene="res://scenes/Main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="PaleoSphere"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/energy_saving/keep_screen_on=false

[dotnet]

project/assembly_name="PaleoSphere"

[rendering]

anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
environment/defaults/default_clear_color=Color(0.35, 0.47, 0.6, 1)

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PALEOSPHERE 시나리오 정의",
  "description": "data/scenarios/*.json. world.seed는 64비트 정수라 문자열 표기를 권장한다.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "world"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,64}$"
    },
    "name": {
      "type": "object",
      "required": [
        "ko"
      ],
      "properties": {
        "ko": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "en": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 600
    },
    "mode": {
      "enum": [
        "scientific",
        "sandbox"
      ],
      "description": "scientific = 시대·지역이 겹치는 종만 사용, sandbox = 자유 구성"
    },
    "world": {
      "type": "object",
      "properties": {
        "seed": {
          "type": [
            "string",
            "integer"
          ]
        },
        "size_cells": {
          "type": "integer",
          "minimum": 32,
          "maximum": 1024
        },
        "cell_size": {
          "type": "number",
          "minimum": 1,
          "maximum": 8
        },
        "relief": {
          "type": "number",
          "minimum": 0,
          "maximum": 80
        },
        "water_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "river": {
          "type": "boolean"
        },
        "initial_vegetation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "vegetation_capacity_scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "vegetation_growth_scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "moisture_bias": {
          "type": "number",
          "minimum": -0.6,
          "maximum": 0.6
        },
        "base_temperature_c": {
          "type": "number",
          "minimum": -10,
          "maximum": 45
        },
        "seasonal_amplitude_c": {
          "type": "number",
          "minimum": 0,
          "maximum": 25
        },
        "diurnal_amplitude_c": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "ticks_per_day": {
          "type": "integer",
          "minimum": 600,
          "maximum": 864000
        },
        "days_per_season": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "start_hour": {
          "type": "number",
          "minimum": 0,
          "maximum": 23.99
        }
      }
    },
    "populations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "species",
          "count"
        ],
        "properties": {
          "species": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,64}$"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        }
      }
    }
  }
}
